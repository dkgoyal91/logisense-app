# Copy to .env and fill in your actual keys.
# This file intentionally keeps secrets out of source control.

APP_NAME="LogiSense AI Copilot"
DEBUG=false
DATABASE_PATH="data/logisense.db"
ROW_LIMIT=50
AI_PROVIDER="fallback"
ENABLE_EXTERNAL_AI=false

# Optional local runtime overrides
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOGISENSE_INSTANCE=""

# Groq
 GROQ_API_KEY="your_groq_api_key_here"

GROQ_MODEL="llama-3.1-8b-instant"

# Gemini
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"
