# Backend-local example. Copy to .env and fill in real values; never commit real secrets.
APP_NAME="LogiSense AI Copilot"
DEBUG=false
DATABASE_PATH="data/logisense.db"
ROW_LIMIT=20
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# Beat the Copilot: "email me the repo" takeaway (Gmail with an App Password; leave blank to only collect addresses)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
# e.g. SMTP_USERNAME="your.address@gmail.com", SMTP_PASSWORD="<16-character app password>"
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="LogiSense @ Flo 2026"
